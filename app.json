{
  "expo": {
    "name": "CeramicPrice",
    "slug": "ceramic-price",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#C4622D"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#C4622D"
      },
      "package": "com.ceramicprice.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C4622D",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
